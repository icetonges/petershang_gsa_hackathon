# Databricks Apps deploy coordinates for mcp-a-creator.
#
# Copy to .env and fill in, then:
#   set -a; source deploy/databricks/.env; set +a
#   bash deploy/databricks/deploy-databricks-app.sh
#
# No secrets here. Authentication comes from your Databricks CLI login.

# --- Workspace ---------------------------------------------------------------
# e.g. https://dbc-00000000-0000.cloud.databricks.com
DATABRICKS_HOST=

# The CLI profile name `databricks auth login` actually saved. It defaults to
# the workspace host, NOT "DEFAULT". List them with: databricks auth profiles
DATABRICKS_CONFIG_PROFILE=DEFAULT

# --- App identity ------------------------------------------------------------
# MUST start with mcp- or AI Playground and Unity Gateway will not recognize
# this app as an MCP server.
APP_NAME=mcp-a-creator

# Absolute workspace path the app deploys from. Replace <you> with your
# workspace username or email.
SOURCE_CODE_PATH=/Workspace/Users/<you>/mcp-a-creator
