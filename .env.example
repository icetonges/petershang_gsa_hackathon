# ─── MCP transport ────────────────────────────────────────────────────────────
# "stdio"           — local subprocess (Claude Desktop, Claude Code, Cursor)
# "streamable-http" — remote HTTP server
#
# On Databricks Apps leave this as stdio: app.py switches to HTTP
# automatically when the platform injects DATABRICKS_APP_PORT.
MCP_TRANSPORT=stdio
MCP_HOST=0.0.0.0
MCP_PORT=8000

# ─── Writing generated projects to disk ───────────────────────────────────────
# creator_generate_project returns a file manifest. Writing it to disk is a
# side effect, so it is off unless BOTH of these are set. Every path is
# resolved inside the root and traversal is refused.
#
# Leave writing off in a deployed app: there is no durable filesystem there.
# Useful when running the server locally over stdio from a coding agent.
CREATOR_ALLOW_WRITE=false
CREATOR_OUTPUT_ROOT=

# ─── Optional live Unity Catalog inspection ───────────────────────────────────
# With a host, a warehouse, and a credential, creator_profile_data_source can
# read a real table's schema, row count, and distinct values instead of
# parsing a pasted schema. Everything works without these.
CREATOR_ENABLE_LIVE_PROFILING=true
DATABRICKS_HOST=
DATABRICKS_WAREHOUSE_ID=
DATABRICKS_TOKEN=
# Injected automatically inside a Databricks App:
DATABRICKS_CLIENT_ID=
DATABRICKS_CLIENT_SECRET=
